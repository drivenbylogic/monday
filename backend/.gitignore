# =============================================================================
# Monday Backend - .gitignore
# =============================================================================

# --- Gradle ---
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# --- Maven (if ever used) ---
target/
!.mvn/wrapper/maven-wrapper.jar

# --- IDE ---
.idea/
*.iml
.vscode/
*.swp
out/
.project
.classpath
.settings/
.factorypath

# --- Java ---
*.class
*.jar
!gradle/wrapper/*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# --- Spring Boot ---
application-local.yml
application-local.properties

# --- Environment & Secrets ---
.env
.env.*
!.env.example

# --- Logs ---
*.log
logs/

# --- OS ---
.DS_Store
Thumbs.db
