# =============================================================================
# Monday Backend - Environment Variables Configuration
# =============================================================================

# --- Server & Cloud Environment ---
# Dynamic port assigned by cloud providers (Cloud Run, Railway, Render, App Runner)
PORT=8080

# --- Database Connection (PostgreSQL) ---
# Direct JDBC URL (e.g. AWS RDS, Cloud SQL, Supabase, Neon)
# Example for Neon/Supabase: jdbc:postgresql://ep-xyz.us-east-2.aws.neon.tech:5432/monday?sslmode=require
MONDAY_DB_URL=jdbc:postgresql://localhost:5432/monday
MONDAY_DB_USERNAME=postgres
MONDAY_DB_PASSWORD=admin

# Alternatively, Spring Boot standard properties can also be used:
# SPRING_DATASOURCE_URL=jdbc:postgresql://...
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=admin

# Connection Pool (HikariCP)
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_TIMEOUT_MS=20000

# --- Database Migrations ---
# Set to 'true' if you want Flyway to auto-run classpath:db/migration on startup
SPRING_FLYWAY_ENABLED=false

# --- Security & Session Cookies ---
# In cloud production / cross-domain deployments, keep MONDAY_SESSION_SECURE=true and MONDAY_SESSION_SAME_SITE=none
MONDAY_SESSION_SECURE=true
MONDAY_SESSION_SAME_SITE=none

# --- CORS Allowed Origins ---
# Comma-separated list of frontend URLs allowed to access this backend with credentials
CORS_ALLOWED_ORIGINS=https://monday-ui-omega.vercel.app,https://monday-ui-omega.vercel.app/

# --- AI & Intelligence Module ---
OPENAI_API_KEY=
AI_DEFAULT_MODEL=gpt-4o-mini
INTELLIGENCE_SCHEDULER_ENABLED=true
INTELLIGENCE_TIMEZONE=Asia/Kolkata

# --- Observability & Logging ---
LOGGING_LEVEL_APP=INFO
LOGGING_LEVEL_SQL=WARN
